{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "noEmit": true,
    "jsx": "react-jsx", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "vite/client", "node"],
    "allowImportingTsExtensions": true
  },
  "include": ["shared", "worker", "web/src", "tests", "vite.config.ts"]
}
